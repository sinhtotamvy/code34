<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Code34 - Ecosystem</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Orbitron:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #050508;
            --card-bg: #121215;
            --primary-blue: #00e5ff;
            --primary-glow: rgba(0, 229, 255, 0.3);
            --text-white: #ffffff;
            --text-gray: #a0a0a5;
            --border-color: #2a2a35;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg-color);
            background-image: 
                linear-gradient(rgba(0, 229, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 229, 255, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            color: var(--text-white);
            font-family: 'Inter', sans-serif;
            line-height: 1.6;
        }

        /* HEADER & LOGO */
        header {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding: 60px 20px 40px;
            text-align: center;
        }

        .logo-container {
            width: 120px;
            height: 120px;
            border: 2px solid var(--border-color);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            transition: 0.3s;
            overflow: hidden;
            background-color: var(--card-bg);
        }

        .logo-container:hover {
            border-color: var(--primary-blue);
            box-shadow: 0 0 20px var(--primary-glow);
        }

        .logo-container img {
            width: 100%;
            height: 100%;
            object-fit: contain; /* Giúp logo không bị méo hay cắt xén */
            padding: 5px;
        }

        h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.5rem;
            letter-spacing: 2px;
            color: var(--text-white);
            text-shadow: 0 0 10px var(--primary-glow);
        }

        .subtitle { color: var(--text-gray); margin-top: 10px; font-size: 1.1rem; }

        /* SẢN PHẨM PHẦN MỀM */
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px 60px;
        }

        .section-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.8rem;
            border-left: 4px solid var(--primary-blue);
            padding-left: 15px;
            margin-bottom: 30px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: rgba(0, 229, 255, 0.5);
            box-shadow: 0 10px 30px var(--primary-glow);
        }

        .card-img-placeholder {
            width: 100%;
            height: 180px;
            background-color: #1a1a20;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-gray);
            border-bottom: 1px solid var(--border-color);
        }
        
        .card-img-placeholder img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .card-content { padding: 20px; }

        .card-title {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 10px;
            color: var(--text-white);
        }

        .btn-group {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .btn {
            flex: 1;
            text-align: center;
            padding: 10px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: 0.3s;
        }

        .btn-download {
            background-color: var(--primary-blue);
            color: #000;
        }

        .btn-download:hover { background-color: #00bfff; }

        .btn-video {
            background-color: transparent;
            color: var(--text-white);
            border: 1px solid var(--border-color);
        }

        .btn-video:hover {
            border-color: var(--primary-blue);
            color: var(--primary-blue);
        }

        /* LIÊN HỆ & DONATE */
        .contact-section {
            margin-top: 60px;
            background: linear-gradient(180deg, var(--card-bg) 0%, transparent 100%);
            border-top: 1px solid var(--border-color);
            padding: 60px 20px;
            text-align: center;
        }

        .qr-container {
            display: flex;
            justify-content: center;
            gap: 50px;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .qr-box {
            background-color: var(--bg-color);
            padding: 20px;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            width: 220px;
        }

        .qr-box h3 { margin-bottom: 15px; font-size: 1.1rem; color: var(--primary-blue); }

        .qr-image {
            width: 100%;
            aspect-ratio: 1/1;
            background-color: #1a1a20;
            border-radius: 8px;
            margin-bottom: 10px;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

        .qr-image img {
            width: 100%;
            height: 100%;
            object-fit: contain; /* Đảm bảo mã QR không bị mất góc */
            background-color: #fff; /* Nền trắng để máy quét QR dễ nhận diện hơn */
        }

        footer {
            text-align: center;
            padding: 20px;
            color: var(--text-gray);
            font-size: 0.9rem;
            border-top: 1px solid var(--border-color);
        }
    </style>
</head>
<body>

    <!-- PHẦN HEADER & LOGO -->
    <header>
        <div class="logo-container">
            <!-- ĐÃ CHÈN LOGO CODE34 -->
            <img src="https://storage.googleapis.com/menu-tamvy/code34/logocode34.png" alt="Code34 Logo">
        </div>
        <h1>CODE34</h1>
        <p class="subtitle">Ecosystem & Software Solutions</p>
    </header>

    <!-- PHẦN SẢN PHẨM -->
    <div class="container">
        <h2 class="section-title">Sản Phẩm Nổi Bật</h2>
        <div class="grid">
            
            <!-- SẢN PHẨM 1 -->
            <div class="card">
                <div class="card-img-placeholder">
                    <!-- SAU NÀY LU CÓ ẢNH GIAO DIỆN PHẦN MỀM THÌ THAY LINK VÀO ĐÂY NHÉ -->
                    <!-- <img src="link_anh_phan_mem_1.jpg" alt="Giao diện phần mềm"> -->
                    <span>Ảnh giao diện phần mềm 1</span>
                </div>
                <div class="card-content">
                    <h3 class="card-title">Tên Phần Mềm 01</h3>
                    <p style="color: var(--text-gray); font-size: 0.9rem;">Mô tả ngắn gọn chức năng của phần mềm tại đây. Giúp người dùng dễ hình dung.</p>
                    <div class="btn-group">
                        <a href="LINK_TAI_PHAN_MEM" target="_blank" class="btn btn-download">Tải Về</a>
                        <a href="LINK_VIDEO_HUONG_DAN" target="_blank" class="btn btn-video">Xem Video</a>
                    </div>
                </div>
            </div>

            <!-- SẢN PHẨM 2 -->
            <div class="card">
                <div class="card-img-placeholder">
                    <span>Ảnh giao diện phần mềm 2</span>
                </div>
                <div class="card-content">
                    <h3 class="card-title">Tên Phần Mềm 02</h3>
                    <p style="color: var(--text-gray); font-size: 0.9rem;">Mô tả ngắn gọn chức năng của phần mềm tại đây. Giúp người dùng dễ hình dung.</p>
                    <div class="btn-group">
                        <a href="LINK_TAI_PHAN_MEM" target="_blank" class="btn btn-download">Tải Về</a>
                        <a href="LINK_VIDEO_HUONG_DAN" target="_blank" class="btn btn-video">Xem Video</a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- PHẦN LIÊN HỆ & DONATE -->
    <div class="contact-section">
        <h2 class="section-title" style="display: inline-block; border-left: none; border-bottom: 4px solid var(--primary-blue); padding-bottom: 5px;">Kết Nối & Hỗ Trợ</h2>
        <div class="qr-container">
            
            <!-- QR ZALO -->
            <div class="qr-box">
                <h3>Quét Zalo Liên Hệ</h3>
                <div class="qr-image">
                    <!-- ĐÃ CHÈN QR ZALO -->
                    <img src="https://storage.googleapis.com/menu-tamvy/code34/zalocode34.jpg" alt="QR Zalo Code34">
                </div>
                <p style="color: var(--text-gray); font-size: 0.85rem;">Quét mã để trao đổi trực tiếp với mìn 🤓</p>
            </div>

            <!-- QR DONATE -->
            <div class="qr-box">
                <h3>Ủng Hộ Code34</h3>
                <div class="qr-image">
                    <!-- ĐÃ CHÈN QR NGÂN HÀNG BIDV -->
                    <img src="https://storage.googleapis.com/menu-tamvy/code34/bidvcode34.jpg" alt="QR Ngân Hàng BIDV Code34">
                </div>
                <p style="color: var(--text-gray); font-size: 0.85rem;">donate cho mìn một ly cà phê nhó 🫡</p>
            </div>

        </div>
    </div>

    <footer>
        <p>&copy; 2026 Code34 Ecosystem. Built by Lu.</p>
    </footer>

</body>
</html>
